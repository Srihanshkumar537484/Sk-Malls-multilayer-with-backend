# ============================================================================
# SK MALLS — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. This .env.example must only ever contain placeholders.
# ============================================================================

# --- Supabase (free tier) ---------------------------------------------------
# From: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side ONLY, never exposed to the browser, never
# prefixed with NEXT_PUBLIC_. Used only in API routes / server actions that
# need to bypass RLS for legitimate admin tasks (e.g. sending emails).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MALL_NAME="SK Malls"

# --- Email (optional at ₹0 launch — leave blank and email sends will no-op
# and be logged to the email_log table instead of blocking orders) -----------
# Free-tier option: Resend (100 emails/day free) or Supabase's built-in
# auth email (limited, auth-only). Leave blank to skip email entirely.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="SK Malls <orders@example.com>"

# --- WhatsApp click-to-chat (free, no API required) -------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# --- Payment gateway (NOT required for ₹0 launch — COD works without this) --
# Fill these in only when you're ready to enable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
